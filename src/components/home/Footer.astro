---
import * as i from './icons';
import { site } from '../../data/site';
interface Props { home?: boolean; extras?: boolean }
const { home = true, extras = home } = Astro.props;
const href = (h: string) => (home && h.startsWith('/#') ? h.slice(1) : h);
const f = site.footer;
// giant wordmark: full name, one span per letter (the wave effect moves each letter)
const letters = [...site.fullName];
// bottom-left label: the site's own domain (from site.url)
const domain = site.url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---
<footer class="foot">
  <canvas id="footDots" class="foot-canvas" aria-hidden="true"></canvas>
  <div class="foot-horizon"></div>
  <span class="foot-flabel"><span class="ff-mark"></span> footer.frame</span>
  <button class="foot-totop" id="toTop" type="button" aria-label="Back to top"><Fragment set:html={i.s19} /></button>
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-cta">
        <div class="foot-eyebrow">{f.eyebrow}</div>
        <a class="foot-mail" href={`mailto:${site.email}`}>{site.email} <Fragment set:html={i.s20} /></a>
        <div class="foot-row"><a class="foot-book" href="/contact">{f.bookLabel} <Fragment set:html={i.s21} /></a><span class="foot-live"><span class="foot-dot"></span> {site.status}</span></div>
      </div>
      <div class="foot-nav">
        {f.columns.map((c) => <div class="fcol"><h2>{c.title}</h2>{c.links.map((l) => <a href={href(l.href)}>{l.label}</a>)}</div>)}
        <div class="fcol"><h2>Connect</h2>{site.socials.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}<a href={`mailto:${site.email}`}>Email</a><a href={site.cv.href} download={site.cv.file}>CV</a></div>
      </div>
    </div>
  </div>
  <div class="foot-stage reveal">
    <div class="foot-word foot-word--full" id="footWord" role="img" aria-label={site.fullName}>{letters.map((ch, k) => ch === ' ' ? <span class="sp" aria-hidden="true"></span> : <span class={k === 0 ? 'o' : undefined} aria-hidden="true">{ch}</span>)}</div>
  </div>
  <div class="foot-rule"></div>
  <div class="wrap"><div class="foot-bar"><span class="fbar-l"><b></b> {domain}</span><span class="fbar-c"><span class="foot-dot"></span> 2 cursors online &middot; <span id="fClock">--:--</span> {site.location.tzLabel}</span><span class="fbar-r">{f.copyright}</span></div></div>
</footer>

{extras && <Fragment><Fragment set:html={i.s22} /><div id="phMeasLbl"></div><div id="phBub"></div></Fragment>}

{extras && site.whatsapp && (
<div id="waFloat" class="wa-float"><button class="wa-x" type="button" aria-label="Close WhatsApp chat">&times;</button><a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener"><span class="wa-av"><span class="wa-dot"></span></span><span class="wa-body"><span class="wa-top"><b>{site.brand}</b><span class="wa-now">online</span></span><span class="wa-msg">Why wait? <span class="a">Let’s chat &rarr;</span></span></span></a></div>
)}
