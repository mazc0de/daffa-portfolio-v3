---
// "Nice to meet you" bento (from handoff/sections-about-experience.md): portrait frame,
// hello statement, quick facts, skills, currently building. Copy lives in `site.about`.
// Reuses bento/cell/chip styles from home.css; me-* classes are in the About section at the end of /css/home.css.
import * as i from './icons';
import { site } from '../../data/site';
import { srcset } from '../../data/assets';
const a = site.about;
const icons: Record<string, string> = {
  layout: i.s2,
  code: i.s3,
  layers: i.s4,
  target: i.s5,
  play: i.s6,
  grid: i.s7,
  search: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg>',
  next: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M9.5 16V8l6.5 9M15 8v5"/></svg>',
  react: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><ellipse cx="12" cy="12" rx="10" ry="4"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(120 12 12)"/><circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/></svg>',
  ts: '<svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="4" fill="currentColor"/><text x="12" y="16.5" text-anchor="middle" font-family="ui-monospace,monospace" font-size="10" font-weight="700" fill="#fff">TS</text></svg>',
  js: '<svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="4" fill="none" stroke="currentColor" stroke-width="2"/><text x="12" y="16.5" text-anchor="middle" font-family="ui-monospace,monospace" font-size="10" font-weight="700" fill="currentColor">JS</text></svg>',
  tailwind: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 11c1.6-3.2 3.8-4 6.4-2.4C11.6 10 13 11 15.5 9.6M8.5 17c1.6-3.2 3.8-4 6.4-2.4 2.2 1.4 3.6 2.4 6.1 1"/></svg>',
  api: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 8h12M12 4l4 4-4 4M20 16H8M12 12l-4 4 4 4"/></svg>',
  a11y: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="7.5" r="1.2" fill="currentColor"/><path d="M7.5 10.5 12 11.5l4.5-1M12 11.5v3l-2.5 3.5M12 14.5l2.5 3.5"/></svg>',
};
---
<section class="about me-about" id="about">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="scribble me-scribble">{a.scribble}</span>
      <h2>{a.heading}</h2>
      <span class="note">{a.note}</span>
    </div>

    <div class="bento stagger me-bento">
      <figure class="cell me-photo" style="--i:0">
        <span class="me-flab" aria-hidden="true"><Fragment set:html={i.s8} />{a.photo.split('/').pop()}</span>
        <div class="me-frame">
          <img src={a.photo} srcset={srcset(a.photo, [480], a.photoSize.w)} sizes="(max-width: 900px) 80vw, 34vw" alt={`Portrait of ${site.fullName}`} width={a.photoSize.w} height={a.photoSize.h} loading="lazy" decoding="async" draggable="false" />
          <span class="me-hd tl"></span><span class="me-hd tr"></span><span class="me-hd bl"></span><span class="me-hd br"></span>
        </div>
        <span class="me-dim" aria-hidden="true">{a.photoSize.w} &times; {a.photoSize.h}</span>
        <span class="me-curs" aria-hidden="true"><Fragment set:html={i.s10} /><span class="me-nm">{site.brand}</span></span>
        <figcaption class="sr-only">{site.fullName}, {site.tagline}</figcaption>
      </figure>

      <div class="cell c-stmt me-stmt" style="--i:1"><span class="clbl">HELLO.TXT</span>
        <div class="stmt-quote">
          <h3 class="stmt-head">{a.lead} <span class="stmt-em">{a.em}</span></h3>
          <p class="stmt-sub" set:html={a.bio}></p>
        </div>
        <div class="stmt-foot2"><span class="stmt-sign2">{site.fullName}, since {site.since}</span><span class="me-foot-end"><span class="stmt-avail2"><i></i>{site.status}</span><a class="me-cv" href={site.cv.href} download={site.cv.file}>{site.cv.label} <Fragment set:html={i.dl} /></a></span></div>
      </div>

      <div class="cell me-facts" style="--i:2"><span class="clbl">QUICK FACTS</span>
        <dl>
          {a.facts.map((f) => (
            <div class="me-fact"><dt>{f.k}</dt><dd>{f.v}</dd></div>
          ))}
        </dl>
      </div>

      <div class="cell c-skills me-skills" style="--i:3"><span class="clbl">WHAT I DO</span>
        <ul class="chips">
          {a.skills.map((s) => <li class="chip"><i aria-hidden="true"><Fragment set:html={icons[s.icon] ?? i.s8} /></i>{s.label}</li>)}
        </ul>
      </div>

      <div class="cell c-now me-now" style="--i:4"><span class="label">{a.nowLabel}</span><div class="nbig">{a.now}</div>
        <div class="tools">{a.tools.map((t) => <span class="tchip">{t}</span>)}</div>
        <div class="eq" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
      </div>
    </div>
  </div>
</section>
