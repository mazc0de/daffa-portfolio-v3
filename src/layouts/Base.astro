---
import { site, clientConfig } from '../data/site';
import { versioned } from '../data/assets';

interface Props {
  title?: string;
  description?: string;
  /** page-specific stylesheet (imported by the page) is bundled automatically */
  scripts?: string[];
  /** external libraries to load before page scripts */
  vendor?: string[];
  fontCss?: string[];
  /** static, unprocessed stylesheets (served from /public as-is) */
  css?: string[];
  /** keep the page out of search results (404) */
  noindex?: boolean;
  /** woff2 files to preload (fonts needed for the first screen) */
  fontPreload?: string[];
  /** third-party origins the page calls early */
  preconnect?: string[];
  /** link-preview image for this page (1200×630); defaults to the site-wide site.ogImage */
  image?: { src: string; alt: string };
}

const {
  title = `${site.fullName} | ${site.tagline}`,
  description = site.description,
  scripts = [],
  vendor = [],
  fontCss = [],
  css = [],
  noindex = false,
  fontPreload = [],
  preconnect = [],
  image,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
// structured data: who the site is about (Person) and what the site is called (WebSite, which Google uses
// for the site name shown above the result). Both point at each other through @id.
const home = new URL('/', site.url).href;
const job = site.experience.versions.find((v) => v.current);
const school = site.experience.versions.find((v) => /universit/i.test(v.company));
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      url: home,
      name: site.fullName,
      alternateName: [site.brand, new URL(site.url).hostname],
      inLanguage: 'en',
      publisher: { '@id': `${home}#person` },
    },
    {
      '@type': 'Person',
      '@id': `${home}#person`,
      name: site.fullName,
      alternateName: site.brand,
      jobTitle: site.tagline,
      image: new URL(site.about.photo, site.url).href,
      url: home,
      email: site.email,
      description: site.description,
      sameAs: site.socials.map((s) => s.href),
      address: { '@type': 'PostalAddress', addressLocality: site.location.city, addressCountry: 'ID' },
      ...(job && { worksFor: { '@type': 'Organization', name: job.company } }),
      ...(school && { alumniOf: { '@type': 'CollegeOrUniversity', name: school.company } }),
      knowsAbout: ['Frontend development', 'React', 'Next.js', 'TypeScript', 'Tailwind CSS', 'Web accessibility', 'Web performance'],
    },
  ],
};
const ogImage = new URL(image?.src ?? site.ogImage, site.url).href;
const ogImageType = /\.jpe?g(\?|$)/.test(ogImage) ? 'image/jpeg' : 'image/png';
// bump when the logo or icons change: browsers keep favicons in their own cache and a new URL forces a fresh copy
const iconV = '?v=2';
const ogImageAlt = image?.alt ?? `${site.fullName}, ${site.tagline}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#5EAEEA" />
    <script is:inline>
      // theme: the visitor's choice (saved by the toggle) or else the system setting. Set before anything
      // paints so a dark page never flashes white. The dark stylesheets only apply under data-theme="dark".
      (function () {
        var t;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'dark' && t !== 'light') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
        if (t === 'dark') document.querySelector('meta[name="theme-color"]').setAttribute('content', '#08111D');
      })();
    </script>
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="icon" href={`/favicon.ico${iconV}`} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={`/favicon.svg${iconV}`} />
    <!-- Google Search wants a favicon that is a multiple of 48px; the .ico only holds 16 and 32 -->
    <link rel="icon" type="image/png" sizes="192x192" href={`/android-chrome-192x192.png${iconV}`} />
    <link rel="apple-touch-icon" href={`/apple-touch-icon.png${iconV}`} />
    <link rel="manifest" href={`/site.webmanifest${iconV}`} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {preconnect.map((href) => <link rel="preconnect" href={href} crossorigin />)}
    {fontPreload.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    {fontCss.map((href) => <link rel="stylesheet" href={versioned(href)} />)}
    {css.map((href) => <link rel="stylesheet" href={versioned(href)} />)}
    <link rel="stylesheet" href={versioned('/css/brand.css')} />
    <!-- night versions of the page stylesheets (generated by scripts/build-dark-css.mjs), scoped to data-theme="dark" -->
    {css.map((href) => <link rel="stylesheet" href={versioned(href.replace(/\.css$/, '-dark.css'))} />)}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // a refresh always starts at the top (the browser would otherwise restore the old scroll
      // position or jump to the #hash). Links like /#about and back/forward keep working as usual.
      (function () {
        var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        if (!nav || nav.type !== 'reload') return;
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        function top() { window.scrollTo(0, 0); }
        top();
        document.addEventListener('DOMContentLoaded', top);
        window.addEventListener('load', function () {
          top();
          // back to normal afterwards, so back/forward still remember where you were
          setTimeout(function () { top(); if ('scrollRestoration' in history) history.scrollRestoration = 'auto'; }, 0);
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script is:inline define:vars={{ cfg: clientConfig }}>window.__SITE__ = cfg;</script>
    <script is:inline>
      // tab icon: a ghost emoji (👻) while the visitor is on another tab, the normal mark when they come back
      (function () {
        // every icon link swaps (.ico and .svg), otherwise the browser can keep showing the one left alone
        var icons = Array.prototype.slice.call(document.querySelectorAll('link[rel="icon"]'));
        if (!icons.length) return;
        var home = icons.map(function (l) { return l.getAttribute('href'); }), away = '/favicon-away.svg';
        new Image().src = away; // warm the cache so the swap is instant
        document.addEventListener('visibilitychange', function () {
          icons.forEach(function (l, k) { l.setAttribute('href', document.hidden ? away : home[k]); });
        });
      })();
    </script>
    <script is:inline>
      // theme toggle (button in the nav pill). Saves the choice, follows the system while there is none,
      // and fires a "themechange" event so canvases drawn in script can repaint with the new colors.
      (function () {
        var root = document.documentElement, meta = document.querySelector('meta[name="theme-color"]');
        var btns = document.querySelectorAll('[data-theme-toggle]');
        function sync() {
          var dark = root.getAttribute('data-theme') === 'dark';
          meta.setAttribute('content', dark ? '#08111D' : '#5EAEEA');
          btns.forEach(function (b) {
            b.setAttribute('aria-pressed', String(dark));
            b.setAttribute('title', dark ? 'Switch to light mode' : 'Switch to dark mode');
          });
        }
        function apply(t) {
          root.setAttribute('data-theme', t);
          sync();
          window.dispatchEvent(new CustomEvent('themechange', { detail: t }));
        }
        function swap(t, btn) {
          var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!document.startViewTransition || still || !btn) {
            root.classList.add('theme-switching');
            apply(t);
            requestAnimationFrame(function () { requestAnimationFrame(function () { root.classList.remove('theme-switching'); }); });
            return;
          }
          // the new theme grows out of the button as a circle
          var r = btn.getBoundingClientRect(), x = r.left + r.width / 2, y = r.top + r.height / 2;
          var end = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
          root.classList.add('theme-switching');
          var vt = document.startViewTransition(function () { apply(t); });
          vt.ready.then(function () {
            root.animate({ clipPath: ['circle(0px at ' + x + 'px ' + y + 'px)', 'circle(' + end + 'px at ' + x + 'px ' + y + 'px)'] },
              { duration: 520, easing: 'cubic-bezier(.4,0,.2,1)', pseudoElement: '::view-transition-new(root)' });
          });
          vt.finished.then(function () { root.classList.remove('theme-switching'); });
        }
        btns.forEach(function (b) {
          b.addEventListener('click', function () {
            var t = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            try { localStorage.setItem('theme', t); } catch (e) {}
            swap(t, b);
          });
        });
        matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
          var saved;
          try { saved = localStorage.getItem('theme'); } catch (err) {}
          if (!saved) swap(e.matches ? 'dark' : 'light');
        });
        sync();
      })();
    </script>
    {vendor.map((src) => <script is:inline src={versioned(src)}></script>)}
    {scripts.map((src) => <script is:inline src={versioned(src)}></script>)}
  </body>
</html>
